{
  "name": "moleculer-browser",
  "version": "0.0.3",
  "description": "Moleculer for the browser.",
  "main": "dist/moleculer.umd.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rollup -c rollup.config.mjs",
    "test": "vitest run",
    "test:bundle": "esbuild tests/server/index.js --bundle --outdir=tests/server/dist --platform=browser --format=iife --define:global=globalThis --alias:path=./test/node-shims.js --alias:os=./test/node-shims.js --alias:fs=./test/node-shims.js --alias:stream=./test/node-shims.js --alias:crypto=./test/node-shims.js --alias:util=./test/shim-util.js --alias:glob=./test/node-shims.js --alias:kleur=./test/node-shims.js",
    "test:serve": "npm run build && npm run test:bundle",
    "posttest": "npm run lint",
    "lint": "eslint --ignore-path .eslintignore \"**/*.js\"",
    "prepublishOnly": "npm test && npm run build",
    "example:full:client": "npm run build && cd examples/fullstack && webpack-dev-server --progress --mode development",
    "example:full:client:build": "npm run build && cd examples/fullstack && webpack --progress --mode production",
    "example:full:server": "node examples/fullstack/server.js"
  },
  "dependencies": {
    "browser-process-hrtime": "^1.0.0",
    "cpus": "^1.0.3",
    "eventemitter2": "^6.4.9",
    "fastest-validator": "^1.19.1",
    "lru-cache": "^11.2.7",
    "moleculer": "^0.15.0",
    "process": "^0.11.10",
    "raf-perf": "^1.2.0",
    "timers-browserify": "^2.0.11"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "fast-glob": "^3.2.4",
    "html-webpack-plugin": "^4.5.0",
    "moleculer-repl": "^0.6.4",
    "playwright": "^1.59.1",
    "rollup": "^4.60.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "socket.io": "^2.3.0",
    "socket.io-client": "^2.3.0",
    "vitest": "^4.1.2",
    "webpack": "^4.44.2",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icebob/moleculer-browser.git"
  },
  "keywords": [
    "moleculer",
    "browser",
    "microservices"
  ],
  "author": {
    "name": "icebob"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/icebob/moleculer-browser/issues"
  },
  "homepage": "https://github.com/icebob/moleculer-browser#readme"
}
